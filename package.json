{
  "name": "@openagentsinc/pylon",
  "version": "0.3.0",
  "description": "Modern Pylon contributor node built on Bun, Effect, and OpenTUI",
  "private": false,
  "main": "src/index.ts",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "effect": "4.0.0-beta.70",
      "typescript": "^6.0.3"
    }
  },
  "bin": {
    "pylon": "src/index.ts"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "src",
    "packages/runtime/src",
    "packages/runtime/package.json",
    "docs/images/pylon.png",
    "docs/*.md",
    "docs/benchmarks",
    "docs/probe-port",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAgentsInc/pylon.git"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "runtime": "bun --cwd packages/runtime src/cli.ts",
    "runtime:test": "bun run --cwd packages/runtime test",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.3.4",
    "@openagentsinc/pylon-runtime": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "bun-types": "^1.0.0"
  }
}
