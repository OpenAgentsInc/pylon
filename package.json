    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAgentsInc/pylon.git"
  },
  "scripts": {
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "@opentui/core": "^0.3.4",
    "effect": "^3.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.0.0"
  }
}
